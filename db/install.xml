<?xml version="1.0" encoding="UTF-8" ?>
<!-- report/boletim/db/install.xml -->
<XMLDB PATH="report/boletim/db" VERSION="20260817" COMMENT="XMLDB file for report_boletim; XMLDB Editor rules and information in http://docs.moodle.org/dev/XMLDB_editor"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
    <TABLES>
        <TABLE NAME="report_boletim_status" COMMENT="Global Attendance status classification">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="acronym" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="description" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="classification" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" DEFAULT="neutral"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
                <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="usermodified_fk" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="acronym_description_uix" UNIQUE="true" FIELDS="acronym,description"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
